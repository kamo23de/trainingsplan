# Vorlage: nach .env kopieren und bei Bedarf anpassen.
# Alle Werte haben sinnvolle Standards; .env ist nur für Abweichungen nötig.

# Ablageort für Rohdaten (FIT-Dateien, Garmin-Export) und Datenbank
TP_DATA_DIR=./data

# Datenbank-URL. Lokal SQLite; auf einem Server z. B.
# postgresql+psycopg://user:pass@host/trainingsplan
# TP_DATABASE_URL=sqlite:///./data/trainingsplan.db

# Zeitraum der Historie in Jahren
TP_HISTORY_YEARS=4

# Der Garmin Personal API Key gehört NICHT in diese Datei.
# Lokal liegt er im macOS-Schlüsselbund (siehe README: `trainingsplan garmin-key`).
# Auf einem Server kann er alternativ als Umgebungsvariable gesetzt werden:
# TP_GARMIN_API_KEY=
